---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { BOOKING_URL, breadcrumbs } from '../lib/site';
import '../styles/contact.css';

const schema = [
  { '@type': 'ContactPage', url: Astro.url.href, name: 'Contact In The Kitchen' },
  breadcrumbs([['Home', '/'], ['Contact', '/contact-us/']]),
];
---

<BaseLayout
  title="Contact us | In The Kitchen"
  description="Contact In The Kitchen to discuss positioning for your B2B technology company."
  bodyClass="body-new contact-page"
  image="/og/contact.png"
  schema={schema}
>
  <div class="page-wrapper">
    <Nav />

    <main class="contact-main">
      <section class="section contact-hero" aria-labelledby="contact-heading">
        <div class="contact-hero-container">
          <div class="contact-folder" style="--contact-tab-mask: url('/assets/yellow-tab.svg')">
            <h1 id="contact-heading">Contact us</h1>
            <p>Send an email to jon@inthekitchen.is</p>
            <a href={BOOKING_URL} target="_blank" rel="noreferrer">
              Book a call
            </a>
          </div>
        </div>
      </section>

      <Faq />
    </main>

    <Footer />
  </div>

  <SiteScripts />
</BaseLayout>
