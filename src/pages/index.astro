---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import Hero from '../components/home/Hero.astro';
import Clients from '../components/home/Clients.astro';
import Investors from '../components/home/Investors.astro';
import PositioningStory from '../components/home/PositioningStory.astro';
import PullQuote from '../components/home/PullQuote.astro';
import DecisionBook from '../components/home/DecisionBook.astro';
import Process from '../components/home/Process.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Founder from '../components/home/Founder.astro';
import Closing from '../components/home/Closing.astro';
import HomeScripts from '../components/home/HomeScripts.astro';
import { faqs } from '../data/faqs';
import '../styles/home.css';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title="Own the positioning | In The Kitchen"
  description="Own the positioning that scales everything."
  bodyClass="body-new"
  image="/og/home.png"
  schema={[faqSchema]}
>
  <script is:inline slot="head">

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('hero-motion-pending');

      window.setTimeout(() => {
        document.documentElement.classList.remove('hero-motion-pending');
      }, 1200);
    }
  </script>

  <Nav overHero />
  <div class="page-wrapper">
    <Hero />
    <Clients />
    <Investors />
    <PositioningStory />
    <PullQuote />
    <DecisionBook />
    <Process />
    <Testimonials />
    <Founder />
    <Closing />
    <Faq />
    <Footer />
  </div>

  <SiteScripts />
  <HomeScripts />
</BaseLayout>
