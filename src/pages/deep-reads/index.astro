---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import SiteScripts from '../../components/SiteScripts.astro';
import '../../styles/site-chrome.css';
import { absolute, breadcrumbs, refs } from '../../lib/site';
import '../../styles/deep-reads-index.css';

const articles = (await getCollection('deep-reads')).sort((a, b) => a.data.order - b.data.order);

const schema = [
  {
    '@type': 'Blog',
    '@id': absolute('/deep-reads/#blog'),
    name: 'Deep Reads',
    url: absolute('/deep-reads/'),
    description:
      'Detailed thinking from Jon Itkin on positioning, category leadership, and the decisions that make B2B technology companies win.',
    author: refs.person,
    publisher: refs.organization,
    blogPost: articles.map((article) => ({
      '@type': 'BlogPosting',
      headline: article.data.title,
      url: absolute(`/deep-reads/${article.id}/`),
      datePublished: article.data.date.toISOString().slice(0, 10),
    })),
  },
  breadcrumbs([['Home', '/'], ['Deep Reads', '/deep-reads/']]),
];
---

<BaseLayout
  title="Deep Reads | In The Kitchen"
  description="Deep Reads from In The Kitchen: detailed thinking about positioning, category leadership, and the decisions that make companies win."
  bodyClass="body-new deep-reads-index-page"
  image="/og/deep-reads.png"
  schema={schema}
>
  <div class="page-wrapper">
    <Nav />
    <main class="deep-reads-index-main">
      <header class="deep-reads-index-hero">
        <div class="deep-reads-index-hero-inner">
          <h1>Go a little deeper.<br />If you dare.</h1>
          <p>
            Deep Reads is where I share what I see while I work alongside founders and CEOs as
            they make the hardest calls of their careers.
          </p>
        </div>
      </header>

      <section class="deep-reads-index-list" aria-labelledby="deep-reads-latest-heading">
        <div class="deep-reads-index-list-inner">
          <h2 id="deep-reads-latest-heading">The latest</h2>
          <div class="deep-reads-card-grid">
            {articles.map((article, index) => (
              <article class="deep-reads-card">
                <a href={`/deep-reads/${article.id}/`} aria-label={`Read ${article.data.title}`}>
                  <div class="deep-reads-card-media">
                    <img
                      src={article.data.thumbnail}
                      alt=""
                      loading={index < 2 ? 'eager' : 'lazy'}
                    />
                  </div>
                  <div class="deep-reads-card-copy">
                    <h3>{article.data.title}</h3>
                    <p>{article.data.description}</p>
                    <span class="deep-reads-card-link">Read More</span>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Faq />
    <Footer />
  </div>

  <SiteScripts />
</BaseLayout>
