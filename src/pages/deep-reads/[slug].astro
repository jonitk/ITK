---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import SiteScripts from '../../components/SiteScripts.astro';
import '../../styles/site-chrome.css';
import '../../styles/deep-read.css';

export async function getStaticPaths() {
  const articles = await getCollection('deep-reads');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const displayDate = data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${data.title} | In The Kitchen`} description={data.description} bodyClass="body-new deep-read-page">
  <div class="page-wrapper">
    <Nav />
    <main class="deep-read-main">
      <header class="deep-read-hero">
        <div class="deep-read-hero-inner">
          <a class="deep-read-back" href="/deep-reads/">Deep Reads</a>
          <h1>{data.title}</h1>
          <p class="deep-read-dek">{data.dek}</p>
          <div class="deep-read-meta">
            <div class="deep-read-author">
              <img src="/assets/jon-itkin-byline.png" alt="" width="48" height="48" />
              <span>Jon Itkin<br /><small>Founder, In The Kitchen</small></span>
            </div>
            <div class="deep-read-details">
              <span>{displayDate}</span>
              <span>{data.readTime}</span>
            </div>
          </div>
        </div>
      </header>

      {data.bottomLine && (
        <section class="deep-read-bottom-line" aria-label="The bottom line">
          <div>
            <h2>The bottom line</h2>
            <p>{data.bottomLine}</p>
          </div>
        </section>
      )}

      <article class="deep-read-article">
        <div class="deep-read-body"><Content /></div>
      </article>

      <section class="deep-read-more">
        <a href="/deep-reads/">
          <span>Keep reading</span>
          <strong>More Deep Reads →</strong>
        </a>
      </section>
    </main>
    <Faq />
    <Footer />
  </div>

  <SiteScripts />
</BaseLayout>
