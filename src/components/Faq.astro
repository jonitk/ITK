---
import { faqs } from '../data/faqs';
---

<section id="faqs" class="section faq-section"><div class="container grid"><div id="w-node-_635d0d8a-0533-d799-8ef3-83714c86d81c-193ec748" class="faq-sticky-column"><h2 class="font-weight-400">Questions, <br/><span class="h2-span">answered</span>.</h2></div><div id="w-node-f523d5ec-cd9f-38c3-90e6-e8182af8fb60-193ec748" class="w-dyn-list"><div role="list" class="faq-list-new w-dyn-items">
  {faqs.map(({ question, answer }) => (
    <div role="listitem" class="w-dyn-item"><div class="faq-item"><div class="faq-header-new"><h3 class="paragraph-l font-weight-400">{question}</h3><div class="plus-icon-faq"><div>+</div></div></div><div style="height:0px" class="faq-answer-wrapper"><div class="faq-answer-inner"><p class="paragraph-s letter-spacing-0 line-height-150">{answer}</p></div></div></div></div>
  ))}
</div></div></div></section>
