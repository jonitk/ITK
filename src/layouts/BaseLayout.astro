---
import GlobalEmbeds from '../components/GlobalEmbeds.astro';
import { SITE_NAME, absolute, organization, person, website } from '../lib/site';
import '../styles/directional-navigation.css';

interface Props {
  /** Full browser-tab title, e.g. "Deep Reads | In The Kitchen". */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  bodyClass: string;
  /** Social preview image in public/, e.g. "/og/home.png". */
  image?: string;
  /** "article" for Deep Reads, "website" for everything else. */
  type?: 'website' | 'article';
  /** Keep the page out of search results (for unfinished pages). */
  noindex?: boolean;
  /** Extra structured data for this page (Article, FAQPage, breadcrumbs...). */
  schema?: Record<string, unknown>[];
  /** Article details for social previews. */
  published?: Date;
}

const {
  title,
  description,
  bodyClass,
  image = '/og/home.png',
  type = 'website',
  noindex = false,
  schema = [],
  published,
} = Astro.props;

const canonical = absolute(Astro.url.pathname);
const imageUrl = absolute(image);

// Every page describes the business, its founder and the site, plus anything
// page-specific, as one linked graph.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, person, website, ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content="Jon Itkin" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="stylesheet" href="/styles/webflow.css" />
    <link rel="icon" href="/assets/favicon-small.png" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI assistants" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <GlobalEmbeds />
    <slot />
  </body>
</html>
